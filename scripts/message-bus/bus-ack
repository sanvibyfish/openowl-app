#!/usr/bin/env python3
"""bus-ack — mark messages as processed (advance the owning agent's watermark).

Usage:
  bus-ack <id>...            # locate each id's inbox and advance its watermark
  bus-ack --agent <name>     # mark ALL unread as processed (drain an inbox)
"""
import argparse
import sys

sys.path.insert(0, __file__ and __file__.rsplit("/", 1)[0] or ".")
import buslib


def main():
    p = argparse.ArgumentParser(description="Mark messages processed on the openOwl message bus")
    p.add_argument("ids", nargs="*", help="message ids to mark processed")
    p.add_argument("--agent", default=None, help="agent whose inbox to drain (marks all unread)")
    args = p.parse_args()

    if args.agent:
        unread = buslib.unread(args.agent, limit=10_000)
        ids = [m["id"] for m in unread]
        buslib.advance_cursor(args.agent, ids)
        print(f"acked {len(ids)} messages for {args.agent}")
        return

    if not args.ids:
        p.error("provide message ids or --agent")

    for mid in args.ids:
        agent = buslib.ack_by_id(mid)
        if agent:
            print(f"acked {mid} (inbox {agent})")
        else:
            print(f"warning: message {mid} not found in any inbox")


if __name__ == "__main__":
    main()
