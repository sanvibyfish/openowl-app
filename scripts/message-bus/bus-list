#!/usr/bin/env python3
"""bus-list — list registered agents (optionally only online)."""
import argparse
import sys

sys.path.insert(0, __file__ and __file__.rsplit("/", 1)[0] or ".")
import buslib


def main():
    p = argparse.ArgumentParser(description="List agents on the openOwl message bus")
    p.add_argument("--online", action="store_true", help="only agents with heartbeat < 5min")
    args = p.parse_args()

    for name, info in sorted(buslib.list_agents(online_only=args.online).items()):
        hb = info.get("heartbeatAgeSec")
        hb_s = f"{hb:.0f}s ago" if hb is not None else "never"
        print(f"{name:<16} kind={info.get('kind','?'):<8} heartbeat={hb_s} cwd={info.get('cwd') or '-'}")


if __name__ == "__main__":
    main()
