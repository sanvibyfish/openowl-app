#!/usr/bin/env python3
"""bus-send — deliver a message to any agent on the message bus.

Usage:
  bus-send <to> "<body>" [--from <agent>] [--kind message|task|reply] [--reply-to <id>]
"""
import argparse
import sys

sys.path.insert(0, __file__ and __file__.rsplit("/", 1)[0] or ".")
import buslib


def main():
    p = argparse.ArgumentParser(description="Send a message on the openOwl message bus")
    p.add_argument("to", help="target agent name (see bus-list)")
    p.add_argument("body", help="message body")
    p.add_argument("--from", dest="sender", default="cli", help="sender agent name")
    p.add_argument("--kind", default="message", choices=["message", "task", "reply"])
    p.add_argument("--reply-to", default=None, help="message id this replies to")
    args = p.parse_args()

    mid = buslib.send(args.to, args.body, sender=args.sender, kind=args.kind, reply_to=args.reply_to)
    print(mid)


if __name__ == "__main__":
    main()
